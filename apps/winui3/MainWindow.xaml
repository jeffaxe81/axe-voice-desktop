<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AXEVoice.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AXE Voice — WinUI 3 (prévia)">
    <Border x:Name="MainShell" Background="{ThemeResource AxvShellBrush}" Padding="12" KeyDown="MainShell_KeyDown">
        <Border.Resources>
            <ResourceDictionary>
                <!-- Theme resources update when MainShell.RequestedTheme changes.
                     Avoid hard-coded light surfaces that stay white in dark mode. -->
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="AxvLogoTextBrush" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AxvShellBrush" Color="#F5F8FD"/>
                        <SolidColorBrush x:Key="AxvBrandBrush" Color="#1365BE"/>
                        <SolidColorBrush x:Key="AxvTitleBrush" Color="#13375D"/>
                        <SolidColorBrush x:Key="AxvSecondaryBrush" Color="#52647B"/>
                        <SolidColorBrush x:Key="AxvStatusBackgroundBrush" Color="#FCE7E7"/>
                        <SolidColorBrush x:Key="AxvStatusTextBrush" Color="#A52834"/>
                        <SolidColorBrush x:Key="AxvStatusDetailBrush" Color="#80505A"/>
                        <SolidColorBrush x:Key="AxvInputBrush" Color="#E2E9F4"/>
                        <SolidColorBrush x:Key="AxvInputTextBrush" Color="#17395F"/>
                        <SolidColorBrush x:Key="AxvKeyBackgroundBrush" Color="White"/>
                        <SolidColorBrush x:Key="AxvKeyTextBrush" Color="#183759"/>
                        <SolidColorBrush x:Key="AxvDetailsBackgroundBrush" Color="#E8EDF6"/>
                        <SolidColorBrush x:Key="AxvDetailsTitleBrush" Color="#15365C"/>
                        <SolidColorBrush x:Key="AxvDetailsTextBrush" Color="#415A72"/>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="AxvLogoTextBrush" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AxvShellBrush" Color="#081A31"/>
                        <SolidColorBrush x:Key="AxvBrandBrush" Color="#1683D8"/>
                        <SolidColorBrush x:Key="AxvTitleBrush" Color="#ECF4FF"/>
                        <SolidColorBrush x:Key="AxvSecondaryBrush" Color="#BAD0EA"/>
                        <SolidColorBrush x:Key="AxvStatusBackgroundBrush" Color="#49212D"/>
                        <SolidColorBrush x:Key="AxvStatusTextBrush" Color="#FFC0C6"/>
                        <SolidColorBrush x:Key="AxvStatusDetailBrush" Color="#EBC2C8"/>
                        <SolidColorBrush x:Key="AxvInputBrush" Color="#243C58"/>
                        <SolidColorBrush x:Key="AxvInputTextBrush" Color="#ECF4FF"/>
                        <SolidColorBrush x:Key="AxvKeyBackgroundBrush" Color="#1B3554"/>
                        <SolidColorBrush x:Key="AxvKeyTextBrush" Color="#ECF4FF"/>
                        <SolidColorBrush x:Key="AxvDetailsBackgroundBrush" Color="#182E49"/>
                        <SolidColorBrush x:Key="AxvDetailsTitleBrush" Color="#EAF4FF"/>
                        <SolidColorBrush x:Key="AxvDetailsTextBrush" Color="#C1D6F0"/>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="AxvLogoTextBrush" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AxvShellBrush" Color="#F5F8FD"/>
                        <SolidColorBrush x:Key="AxvBrandBrush" Color="#1365BE"/>
                        <SolidColorBrush x:Key="AxvTitleBrush" Color="#13375D"/>
                        <SolidColorBrush x:Key="AxvSecondaryBrush" Color="#52647B"/>
                        <SolidColorBrush x:Key="AxvStatusBackgroundBrush" Color="#FCE7E7"/>
                        <SolidColorBrush x:Key="AxvStatusTextBrush" Color="#A52834"/>
                        <SolidColorBrush x:Key="AxvStatusDetailBrush" Color="#80505A"/>
                        <SolidColorBrush x:Key="AxvInputBrush" Color="#E2E9F4"/>
                        <SolidColorBrush x:Key="AxvInputTextBrush" Color="#17395F"/>
                        <SolidColorBrush x:Key="AxvKeyBackgroundBrush" Color="White"/>
                        <SolidColorBrush x:Key="AxvKeyTextBrush" Color="#183759"/>
                        <SolidColorBrush x:Key="AxvDetailsBackgroundBrush" Color="#E8EDF6"/>
                        <SolidColorBrush x:Key="AxvDetailsTitleBrush" Color="#15365C"/>
                        <SolidColorBrush x:Key="AxvDetailsTextBrush" Color="#415A72"/>
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Border.Resources>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="64"/>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="32" Width="32" Background="{ThemeResource AxvBrandBrush}"
                        CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="A" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource AxvLogoTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="AXE Voice" FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource AxvTitleBrush}"/>
                    <TextBlock Text="WinUI 3 · Avaliação" FontSize="10" Foreground="{ThemeResource AxvSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="ThemeToggle" Content="☾" AutomationProperties.Name="Usar tema escuro"
                        ToolTipService.ToolTip="Claro / escuro" Click="Theme_Click"
                        Background="Transparent" BorderThickness="0" Padding="10,4"
                        VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="1" CornerRadius="10" Background="{ThemeResource AxvStatusBackgroundBrush}" Padding="10"
                    Margin="0,6,0,7">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="SipStatusText" Text="● SIP INDISPONÍVEL"
                               Foreground="{ThemeResource AxvStatusTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="BackendHint" Text="Motor nativo ainda não vinculado"
                               FontSize="10" Foreground="{ThemeResource AxvStatusDetailBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="5" Margin="0,4,0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="20"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="39"/>
                    <ColumnDefinition Width="39"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Destination" Grid.Row="0" Grid.Column="0" FontSize="17"
                         CornerRadius="10" PlaceholderText="Ramal ou URI SIP"
                         MaxLength="128" TextChanged="Destination_TextChanged"
                         KeyDown="Destination_KeyDown"
                         AutomationProperties.Name="Número ou URI SIP de destino"/>
                <Button Grid.Row="0" Grid.Column="1" Content="⌫" FontSize="18"
                        Click="Backspace_Click" CornerRadius="10"
                        Background="{ThemeResource AxvInputBrush}"
                        Foreground="{ThemeResource AxvInputTextBrush}" BorderThickness="0"
                        AutomationProperties.Name="Apagar último dígito"/>
                <Button x:Name="AddFavoriteButton" Grid.Row="0" Grid.Column="2"
                        Content="☆" FontSize="20" Click="AddFavorite_Click"
                        CornerRadius="10" Background="{ThemeResource AxvInputBrush}"
                        Foreground="{ThemeResource AxvInputTextBrush}" BorderThickness="0"
                        AutomationProperties.Name="Adicionar destino aos favoritos protegidos"/>
                <TextBlock x:Name="DestinationFeedback" Grid.Row="1" Grid.ColumnSpan="3"
                           Text="Digite um destino" FontSize="10"
                           Foreground="{ThemeResource AxvSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>

            <Grid x:Name="DialerPanel" Grid.Row="3" RowSpacing="5" ColumnSpacing="5"
                  Margin="0,2,0,7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Row="0" Grid.Column="0" Content="1" Tag="1" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="{ThemeResource AxvKeyBackgroundBrush}" Foreground="{ThemeResource AxvKeyTextBrush}"/>
                <Button Grid.Row="0" Grid.Column="1" Content="2" Tag="2" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="{ThemeResource AxvKeyBackgroundBrush}" Foreground="{ThemeResource AxvKeyTextBrush}"/>
                <Button Grid.Row="0" Grid.Column="2" Content="3" Tag="3" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="{ThemeResource AxvKeyBackgroundBrush}" Foreground="{ThemeResource AxvKeyTextBrush}"/>
                <Button Grid.Row="1" Grid.Column="0" Content="4" Tag="4" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="{ThemeResource AxvKeyBackgroundBrush}" Foreground="{ThemeResource AxvKeyTextBrush}"/>
                <Button Grid.Row="1" Grid.Column="1" Content="5" Tag="5" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="{ThemeResource AxvKeyBackgroundBrush}" Foreground="{ThemeResource AxvKeyTextBrush}"/>
                <Button Grid.Row="1" Grid.Column="2" Content="6" Tag="6" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="{ThemeResource AxvKeyBackgroundBrush}" Foreground="{ThemeResource AxvKeyTextBrush}"/>
                <Button Grid.Row="2" Grid.Column="0" Content="7" Tag="7" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="{ThemeResource AxvKeyBackgroundBrush}" Foreground="{ThemeResource AxvKeyTextBrush}"/>
                <Button Grid.Row="2" Grid.Column="1" Content="8" Tag="8" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="{ThemeResource AxvKeyBackgroundBrush}" Foreground="{ThemeResource AxvKeyTextBrush}"/>
                <Button Grid.Row="2" Grid.Column="2" Content="9" Tag="9" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="{ThemeResource AxvKeyBackgroundBrush}" Foreground="{ThemeResource AxvKeyTextBrush}"/>
                <Button Grid.Row="3" Grid.Column="0" Content="*" Tag="*" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="{ThemeResource AxvKeyBackgroundBrush}" Foreground="{ThemeResource AxvKeyTextBrush}"/>
                <Button Grid.Row="3" Grid.Column="1" Content="0" Tag="0" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="{ThemeResource AxvKeyBackgroundBrush}" Foreground="{ThemeResource AxvKeyTextBrush}"/>
                <Button Grid.Row="3" Grid.Column="2" Content="#" Tag="#" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="{ThemeResource AxvKeyBackgroundBrush}" Foreground="{ThemeResource AxvKeyTextBrush}"/>
            </Grid>

            <Border x:Name="DetailsPanel" Grid.Row="3" Visibility="Collapsed"
                    Background="{ThemeResource AxvDetailsBackgroundBrush}" CornerRadius="12" Padding="10">
                <StackPanel Spacing="7" VerticalAlignment="Center">
                    <TextBlock x:Name="DetailsTitle" FontSize="17" FontWeight="SemiBold"
                               Foreground="{ThemeResource AxvDetailsTitleBrush}" Text="Monitor SIP"/>
                    <TextBlock x:Name="DetailsDescription" FontSize="11"
                               Foreground="{ThemeResource AxvDetailsTextBrush}" TextWrapping="Wrap"
                               Text="Nenhum registro SIP disponível nesta prévia."/>
                    <StackPanel x:Name="FavoritesTools" Visibility="Collapsed" Spacing="5">
                        <TextBlock x:Name="FavoriteCount" FontSize="11"
                                   Foreground="{ThemeResource AxvDetailsTextBrush}"/>
                        <ListView x:Name="FavoriteList" Height="93"
                                  SelectionMode="Single" IsItemClickEnabled="True"
                                  ItemClick="Favorite_ItemClick"
                                  AutomationProperties.Name="Lista de destinos favoritos locais"/>
                        <Button Content="Remover selecionado" Click="DeleteFavorite_Click"
                                CornerRadius="9" FontSize="11"/>
                    </StackPanel>
                    <StackPanel x:Name="MonitorTools" Visibility="Collapsed" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="Atualizar" Click="RefreshMonitor_Click"
                                    CornerRadius="9" FontSize="11"/>
                            <Button Content="Copiar diagnóstico" Click="CopyDiagnostic_Click"
                                    CornerRadius="9" FontSize="11"/>
                        </StackPanel>
                        <TextBlock x:Name="MonitorFeedback" FontSize="10"
                                   Foreground="{ThemeResource AxvDetailsTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel x:Name="SettingsTools" Visibility="Collapsed" Spacing="5">
                        <Button x:Name="SizeModeButton"
                                Content="Tamanho: compacto (alterar)"
                                Click="ChangeSize_Click" FontSize="11" CornerRadius="9"/>
                        <TextBlock Text="Compacto: 355×602 · Conforto: 400×680"
                                   Foreground="{ThemeResource AxvDetailsTextBrush}"
                                   FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button x:Name="CallButton" Grid.Row="4" Margin="0,2,0,5"
                    Content="Ligar · indisponível" IsEnabled="False"
                    CornerRadius="12" FontWeight="SemiBold" FontSize="16"
                    AutomationProperties.Name="Ligar indisponível nesta prévia"/>
            <Grid Grid.Row="5" ColumnSpacing="4" Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Teclado" Click="Dialer_Click"
                        Padding="0" CornerRadius="9" FontSize="11"/>
                <Button Grid.Column="1" Content="Contatos" Click="Contacts_Click"
                        Padding="0" CornerRadius="9" FontSize="11"/>
                <Button Grid.Column="2" Content="Monitor" Click="Monitor_Click"
                        Padding="0" CornerRadius="9" FontSize="11"/>
                <Button Grid.Column="3" Content="Ajustes" Click="Settings_Click"
                        Padding="0" CornerRadius="9" FontSize="11"/>
            </Grid>
        </Grid>
    </Border>
</Window>
