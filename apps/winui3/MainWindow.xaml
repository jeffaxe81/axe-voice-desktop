<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AXEVoice.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AXE Voice — WinUI 3 (prévia)">
    <Border x:Name="MainShell" Background="#F5F8FD" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="64"/>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="32" Width="32" Background="#1365BE"
                        CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="A" FontSize="20" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="AXE Voice" FontSize="16" FontWeight="SemiBold"
                               Foreground="#13375D"/>
                    <TextBlock Text="WinUI 3 · Avaliação" FontSize="10" Foreground="#52647B"/>
                </StackPanel>
                <Button Grid.Column="2" Content="◐" AutomationProperties.Name="Alternar tema"
                        ToolTipService.ToolTip="Claro / escuro" Click="Theme_Click"
                        Background="Transparent" BorderThickness="0" Padding="10,4"
                        VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="1" CornerRadius="10" Background="#FCE7E7" Padding="10"
                    Margin="0,6,0,7">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="SipStatusText" Text="● SIP INDISPONÍVEL"
                               Foreground="#A52834" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="BackendHint" Text="Motor nativo ainda não vinculado"
                               FontSize="10" Foreground="#80505A" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="6" Margin="0,4,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Destination" Grid.Column="0" FontSize="19"
                         CornerRadius="10" PlaceholderText="Digite um número"
                         MaxLength="128" AutomationProperties.Name="Número de destino"
                         VerticalAlignment="Stretch"/>
                <Button Grid.Column="1" Content="⌫" FontSize="20" Click="Backspace_Click"
                        CornerRadius="10" Background="#E2E9F4"
                        Foreground="#17395F" BorderThickness="0"
                        AutomationProperties.Name="Apagar último dígito"/>
            </Grid>

            <Grid x:Name="DialerPanel" Grid.Row="3" RowSpacing="5" ColumnSpacing="5"
                  Margin="0,2,0,7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Row="0" Grid.Column="0" Content="1" Tag="1" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="White" Foreground="#183759"/>
                <Button Grid.Row="0" Grid.Column="1" Content="2" Tag="2" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="White" Foreground="#183759"/>
                <Button Grid.Row="0" Grid.Column="2" Content="3" Tag="3" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="White" Foreground="#183759"/>
                <Button Grid.Row="1" Grid.Column="0" Content="4" Tag="4" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="White" Foreground="#183759"/>
                <Button Grid.Row="1" Grid.Column="1" Content="5" Tag="5" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="White" Foreground="#183759"/>
                <Button Grid.Row="1" Grid.Column="2" Content="6" Tag="6" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="White" Foreground="#183759"/>
                <Button Grid.Row="2" Grid.Column="0" Content="7" Tag="7" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="White" Foreground="#183759"/>
                <Button Grid.Row="2" Grid.Column="1" Content="8" Tag="8" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="White" Foreground="#183759"/>
                <Button Grid.Row="2" Grid.Column="2" Content="9" Tag="9" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="White" Foreground="#183759"/>
                <Button Grid.Row="3" Grid.Column="0" Content="*" Tag="*" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="White" Foreground="#183759"/>
                <Button Grid.Row="3" Grid.Column="1" Content="0" Tag="0" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="White" Foreground="#183759"/>
                <Button Grid.Row="3" Grid.Column="2" Content="#" Tag="#" Click="Digit_Click"
                        FontSize="23" CornerRadius="12" Background="White" Foreground="#183759"/>
            </Grid>

            <Border x:Name="DetailsPanel" Grid.Row="3" Visibility="Collapsed"
                    Background="#E8EDF6" CornerRadius="12" Padding="14">
                <StackPanel Spacing="12" VerticalAlignment="Center">
                    <TextBlock x:Name="DetailsTitle" FontSize="18" FontWeight="SemiBold"
                               Foreground="#15365C" Text="Monitor SIP"/>
                    <TextBlock x:Name="DetailsDescription" FontSize="12"
                               Foreground="#415A72" TextWrapping="Wrap"
                               Text="Nenhum registro SIP disponível nesta prévia."/>
                </StackPanel>
            </Border>

            <Button x:Name="CallButton" Grid.Row="4" Margin="0,2,0,5"
                    Content="Ligar · indisponível" IsEnabled="False"
                    CornerRadius="12" FontWeight="SemiBold" FontSize="16"
                    AutomationProperties.Name="Ligar indisponível nesta prévia"/>
            <Grid Grid.Row="5" ColumnSpacing="4" Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Teclado" Click="Dialer_Click"
                        Padding="0" CornerRadius="9" FontSize="11"/>
                <Button Grid.Column="1" Content="Contatos" Click="Contacts_Click"
                        Padding="0" CornerRadius="9" FontSize="11"/>
                <Button Grid.Column="2" Content="Monitor" Click="Monitor_Click"
                        Padding="0" CornerRadius="9" FontSize="11"/>
                <Button Grid.Column="3" Content="Ajustes" Click="Settings_Click"
                        Padding="0" CornerRadius="9" FontSize="11"/>
            </Grid>
        </Grid>
    </Border>
</Window>
