# Verifies only integrity and Windows PE format of the laboratory build.
# It does NOT prove real SIP / RTP, Baresip SDK provenance or hardware audio.
if(NOT DEFINED AXV_EXE OR NOT EXISTS "${AXV_EXE}")
  message(FATAL_ERROR "LAB executable missing")
endif()
if(NOT DEFINED AXV_OUTPUT OR AXV_OUTPUT STREQUAL "")
  message(FATAL_ERROR "LAB hash manifest destination missing")
endif()
get_filename_component(_filename "${AXV_EXE}" NAME)
if(NOT _filename STREQUAL "AXE-Voice.exe")
  message(FATAL_ERROR "Unexpected executable filename, refusing to attest")
endif()
file(SIZE "${AXV_EXE}" _size)
if(_size LESS 16384)
  message(FATAL_ERROR "LAB executable suspiciously small")
endif()
file(READ "${AXV_EXE}" _magic LIMIT 2 HEX)
if(NOT _magic STREQUAL "4d5a")
  message(FATAL_ERROR "LAB output is not a Windows MZ/PE executable")
endif()
# The DOS MZ marker alone is insufficient: refuse random payloads
# beginning with "MZ". The x64 GUI must carry PE\0\0 and PE32+ headers.
file(READ "${AXV_EXE}" _offset_bytes OFFSET 60 LIMIT 4 HEX)
string(LENGTH "${_offset_bytes}" _offset_bytes_length)
if(NOT _offset_bytes_length EQUAL 8 OR
   NOT _offset_bytes MATCHES "^[0-9a-fA-F]+$")
  message(FATAL_ERROR "Invalid DOS-to-PE header offset")
endif()
string(SUBSTRING "${_offset_bytes}" 0 2 _offset0)
string(SUBSTRING "${_offset_bytes}" 2 2 _offset1)
string(SUBSTRING "${_offset_bytes}" 4 2 _offset2)
string(SUBSTRING "${_offset_bytes}" 6 2 _offset3)
math(EXPR _pe_offset "(0x${_offset0} | (0x${_offset1} << 8) | (0x${_offset2} << 16) | (0x${_offset3} << 24))")
math(EXPR _header_end "${_pe_offset} + 26")
if(_pe_offset LESS 64 OR _pe_offset GREATER 4096 OR _header_end GREATER _size)
  message(FATAL_ERROR "PE offset outside permitted LAB range")
endif()
file(READ "${AXV_EXE}" _pe_header OFFSET "${_pe_offset}" LIMIT 26 HEX)
string(SUBSTRING "${_pe_header}" 0 8 _signature)
string(SUBSTRING "${_pe_header}" 8 4 _machine)
string(SUBSTRING "${_pe_header}" 48 4 _optional_magic)
if(NOT _signature STREQUAL "50450000" OR
   NOT _machine STREQUAL "6486" OR
   NOT _optional_magic STREQUAL "0b02")
  message(FATAL_ERROR "Invalid PE/x64/PE32+ LAB header")
endif()
file(SHA256 "${AXV_EXE}" _sha256)
if(NOT _sha256 MATCHES "^[0-9a-fA-F]+$")
  message(FATAL_ERROR "SHA-256 digest could not be produced")
endif()
# Standard sha256sum-style text. No user/device/secret identifiers.
file(WRITE "${AXV_OUTPUT}" "${_sha256}  AXE-Voice.exe\n")
if(NOT EXISTS "${AXV_OUTPUT}")
  message(FATAL_ERROR "Failed to produce LAB hash manifest")
endif()
message(STATUS "LAB binary verified: ${_size} bytes; SHA256=${_sha256}")
