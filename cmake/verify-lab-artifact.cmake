# Verifies only integrity and Windows PE format of the laboratory build.
# It does NOT prove real SIP / RTP, Baresip SDK provenance or hardware audio.
if(NOT DEFINED AXV_EXE OR NOT EXISTS "${AXV_EXE}")
  message(FATAL_ERROR "LAB executable missing")
endif()
if(NOT DEFINED AXV_OUTPUT OR AXV_OUTPUT STREQUAL "")
  message(FATAL_ERROR "LAB hash manifest destination missing")
endif()
get_filename_component(_filename "${AXV_EXE}" NAME)
if(NOT _filename STREQUAL "AXE-Voice.exe")
  message(FATAL_ERROR "Unexpected executable filename, refusing to attest")
endif()
file(SIZE "${AXV_EXE}" _size)
if(_size LESS 16384)
  message(FATAL_ERROR "LAB executable suspiciously small")
endif()
file(READ "${AXV_EXE}" _magic LIMIT 2 HEX)
if(NOT _magic STREQUAL "4d5a")
  message(FATAL_ERROR "LAB output is not a Windows MZ/PE executable")
endif()
file(SHA256 "${AXV_EXE}" _sha256)
if(NOT _sha256 MATCHES "^[0-9a-fA-F]+$")
  message(FATAL_ERROR "SHA-256 digest could not be produced")
endif()
# Standard sha256sum-style text. No user/device/secret identifiers.
file(WRITE "${AXV_OUTPUT}" "${_sha256}  AXE-Voice.exe\n")
if(NOT EXISTS "${AXV_OUTPUT}")
  message(FATAL_ERROR "Failed to produce LAB hash manifest")
endif()
message(STATUS "LAB binary verified: ${_size} bytes; SHA256=${_sha256}")
