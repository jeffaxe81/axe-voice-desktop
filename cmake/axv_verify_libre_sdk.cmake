# AXE Voice — fail-closed pinned libre/re SDK artifact preflight.
foreach(_name IN ITEMS AXV_LIBRE_INCLUDE_DIR AXV_LIBRE_LIBRARY
                       AXV_LIBRE_HEADER_SHA256 AXV_LIBRE_LIBRARY_SHA256
                       AXV_REPOSITORY_ROOT)
  if(NOT DEFINED ${_name} OR "${${_name}}" STREQUAL "")
    message(FATAL_ERROR "AXE libre preflight: missing ${_name}")
  endif()
endforeach()
set(_header "${AXV_LIBRE_INCLUDE_DIR}/re.h")
if(NOT EXISTS "${_header}" OR IS_DIRECTORY "${_header}")
  message(FATAL_ERROR "AXE libre preflight: re.h not found")
endif()
if(NOT EXISTS "${AXV_LIBRE_LIBRARY}" OR IS_DIRECTORY "${AXV_LIBRE_LIBRARY}")
  message(FATAL_ERROR "AXE libre preflight: libre library not found")
endif()
file(REAL_PATH "${_header}" _header_real)
file(REAL_PATH "${AXV_LIBRE_LIBRARY}" _library_real)
file(REAL_PATH "${AXV_REPOSITORY_ROOT}/tests/fakes/re.h" _fake)
if(WIN32)
  string(TOLOWER "${_header_real}" _header_real)
  string(TOLOWER "${_fake}" _fake)
endif()
if(_header_real STREQUAL _fake)
  message(FATAL_ERROR "AXE libre preflight: test libre header is forbidden")
endif()
get_filename_component(_extension "${_library_real}" EXT)
string(TOLOWER "${_extension}" _extension)
if(NOT _extension STREQUAL ".lib")
  message(FATAL_ERROR "AXE libre preflight: expected MSVC .lib")
endif()
file(SIZE "${_library_real}" _length)
if(_length EQUAL 0)
  message(FATAL_ERROR "AXE libre preflight: libre library must be non-empty")
endif()
foreach(_name IN ITEMS AXV_LIBRE_HEADER_SHA256 AXV_LIBRE_LIBRARY_SHA256)
  set(_pin "${${_name}}")
  string(LENGTH "${_pin}" _size)
  if(NOT _size EQUAL 64 OR NOT _pin MATCHES "^[0-9a-fA-F]+$")
    message(FATAL_ERROR "AXE libre preflight: ${_name} must be 64 hex characters")
  endif()
endforeach()
file(SHA256 "${_header_real}" _actual_header)
file(SHA256 "${_library_real}" _actual_library)
string(TOLOWER "${AXV_LIBRE_HEADER_SHA256}" _expected_header)
string(TOLOWER "${AXV_LIBRE_LIBRARY_SHA256}" _expected_library)
if(NOT _actual_header STREQUAL _expected_header)
  message(FATAL_ERROR "AXE libre preflight: re.h SHA-256 mismatch")
endif()
if(NOT _actual_library STREQUAL _expected_library)
  message(FATAL_ERROR "AXE libre preflight: libre library SHA-256 mismatch")
endif()
message(STATUS "AXE libre preflight: header and library SHA-256 matched (not provenance attestation)")
