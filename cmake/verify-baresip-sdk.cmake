# Verifies explicitly approved SDK bytes before the optional native bridge builds.
# Works in both configure mode and cmake -P (for deterministic regression tests).
foreach(name IN ITEMS AXV_BARESIP_HEADER AXV_BARESIP_LIBRARY)
  if(NOT DEFINED ${name} OR "${${name}}" STREQUAL "" OR
     NOT EXISTS "${${name}}" OR IS_DIRECTORY "${${name}}")
    message(FATAL_ERROR "Baresip SDK gate: ${name} must be an existing regular file")
  endif()
endforeach()
foreach(name IN ITEMS AXV_BARESIP_HEADER_SHA256 AXV_BARESIP_LIBRARY_SHA256)
  if(NOT DEFINED ${name})
    message(FATAL_ERROR "Baresip SDK gate: ${name} is required")
  endif()
  string(LENGTH "${${name}}" axv_hash_length)
  if(NOT axv_hash_length EQUAL 64 OR NOT "${${name}}" MATCHES "^[0-9A-Fa-f]+$")
    message(FATAL_ERROR "Baresip SDK gate: ${name} must be a 64-digit SHA256 hex hash")
  endif()
endforeach()
file(SHA256 "${AXV_BARESIP_HEADER}" actual_header_sha256)
file(SHA256 "${AXV_BARESIP_LIBRARY}" actual_library_sha256)
string(TOLOWER "${AXV_BARESIP_HEADER_SHA256}" expected_header_sha256)
string(TOLOWER "${AXV_BARESIP_LIBRARY_SHA256}" expected_library_sha256)
if(NOT actual_header_sha256 STREQUAL expected_header_sha256)
  message(FATAL_ERROR "Baresip SDK gate: header SHA256 mismatch; do not enable native adapter")
endif()
if(NOT actual_library_sha256 STREQUAL expected_library_sha256)
  message(FATAL_ERROR "Baresip SDK gate: library SHA256 mismatch; do not enable native adapter")
endif()
message(STATUS "Baresip SDK gate: declared header and library SHA256 values match")
